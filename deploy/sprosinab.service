[Unit]
Description=Telegram bot @sprosinab_bot + Mini App API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/sprosinab
Environment=PYTHONUNBUFFERED=1
ExecStart=/root/sprosinab/venv/bin/python /root/sprosinab/main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
