# Скопируйте этот файл в .env и заполните своими значениями:
#     cp .env.example .env
# Файл .env в репозиторий не попадает (см. .gitignore).

# Токен из @BotFather
BOT_TOKEN=

# Юзернейм бота без «@»
BOT_USERNAME=sprosinab_bot

# Telegram ID администраторов через запятую
ADMIN_IDS=

# Рабочий чат (супергруппа) и топик, куда приходят обращения
SUPER_CHAT_ID=
TOPIC_ID=

# Публичный HTTPS-адрес Mini App, без слэша на конце
WEBAPP_URL=https://nab.example.ru

# Внутренний API — наружу его отдаёт nginx по пути /api/
API_HOST=127.0.0.1
API_PORT=8080

# 1 — дублировать обращения в личку каждому админу
NOTIFY_ADMINS_DM=0
