# ---- Скопируйте в .env и подставьте свои значения ----
# cp .env.example .env && nano .env
# Установщик install.sh заполняет этот файл сам и спрашивает только то, чего не знает.

# Токен из @BotFather → /mybots → бот → API Token
BOT_TOKEN=

# Юзернейм бота без «@»
BOT_USERNAME=sprosinab_bot

# Администраторы (Telegram ID через запятую)
ADMIN_IDS=

# Суперчат и топик, куда падают обращения (ID супергруппы начинается с -100)
SUPER_CHAT_ID=
TOPIC_ID=

# Публичный HTTPS-адрес Mini App — без слэша на конце
WEBAPP_URL=https://nab.example.ru

# Внутренний API для Mini App (его проксирует nginx на /api/) — наружу не торчит
API_HOST=127.0.0.1
API_PORT=8080
RUN_API=1

# 0 — статику Mini App отдаёт nginx (рабочий режим); 1 — сам бот (для локальной отладки)
SERVE_STATIC=0

# 1 — копия каждого обращения ещё и в личку админам
NOTIFY_ADMINS_DM=0

# Через сколько часов обращение без ответа считается просроченным
SLA_HOURS=48

# Часовой пояс для напоминаний и отчётов (Москва = 3)
TZ_OFFSET=3

# Где хранить базу, картинки новостей и выгрузки (по умолчанию ./data)
# DATA_DIR=/root/sprosinab/data

# 1 — при старте обновить имя, описание и команды бота
SET_BOT_PROFILE=1

# Ключ шифрования связи с авторами анонимных обращений. Установщик создаёт его сам.
# Не меняйте и не удаляйте — иначе ответы на старые анонимные обращения не дойдут.
SECRET_KEY=
